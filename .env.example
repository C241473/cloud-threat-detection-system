# Application Configuration
APP_NAME="Cloud Security Monitoring & Threat Detection System"
DEBUG=True

# Database Configuration (SQLite default for local, PostgreSQL for docker/prod)
DATABASE_URL="sqlite:///./security_monitor.db"
# For PostgreSQL: DATABASE_URL="postgresql://secuser:secpass@localhost:5432/secdb"

# JWT Security Configuration
SECRET_KEY="super-secret-jwt-key-change-in-production-environments"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Threat Detection Rules Configuration
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
HIGH_REQUEST_RATE_THRESHOLD=50
HIGH_REQUEST_WINDOW_MINUTES=1
